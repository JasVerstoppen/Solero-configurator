rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    
    function isValidQuote(data) {
      return data.customerName is string && data.customerName.size() <= 200 &&
             data.customerEmail is string && data.customerEmail.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.createdAt == request.time;
    }

    match /quotes/{quoteId} {
      allow create, read, update: if true; 
    }
  }
}
